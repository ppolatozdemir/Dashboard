# Notification servisi (şifre sıfırlama OTP e-postaları için)
# Sunucu başlatılmadan önce bu değerleri .env dosyasına kopyalayın.
NOTIFICATION_SERVICE_URL=https://communication.prod.hebiar.com
NOTIFICATION_SERVICE_TOKEN=
NOTIFICATION_MESSAGE_TYPE_EMAIL=2

# Şifre sıfırlama cooldown/deneme sınırlarını devre dışı bırakmak için "true"
PASSWORD_RESET_BYPASS_LIMITS=false

# Yerel auth veritabanı yolu. Belirtilmezse çalışma dizinine göre
# "data/auth.db" kullanılır; bu da sunucunun hangi klasörden başlatıldığına
# bağlı olarak farklı (boş) bir DB'ye işaret edebilir. Kullanıcıların bulunduğu
# DB'yi garanti etmek için mutlak yol verin, örn: C:/.../Dashboard/src/data/auth.db
# AUTH_DB_PATH=
